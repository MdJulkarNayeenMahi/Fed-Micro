)

print("\nDataset loaded successfully.")
print("Shape:", df.shape)


# ==========================================================
# 8. IDENTIFY REQUIRED COLUMNS
# ==========================================================

category_col = None

for col in df.columns:

    if "CONSUMPTION CATEGORY" in str(col).upper():

        category_col = col
        break

if category_col is None:
    raise ValueError(
        "Consumption Category column was not found."
    )


date_col = None

for col in df.columns:

    if str(col).strip().lower() == "date":

        date_col = col
        break

if date_col is None:
    raise ValueError(
        "Date column was not found."
    )


df[category_col] = (
    df[category_col]
    .astype(str)
    .str.strip()
    .str.upper()
)

df[date_col] = pd.to_datetime(
    df[date_col],
