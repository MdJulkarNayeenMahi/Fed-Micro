            cf["E_share"]
        )

        E_share_int_system += (
            intervention["E_share"]
        )

    # ------------------------------------------------------
    # Avoided unserved energy
    # ------------------------------------------------------

    avoided_unserved_system = (
        E_I_cf_system
        -
        E_I_int_system
    )

    # ------------------------------------------------------
    # ATE
    # ------------------------------------------------------

    ATE_system = (
        avoided_unserved_system
        /
        (E_I_cf_system + EPS)
    ) * 100.0

    # ------------------------------------------------------
    # Counterfactual metrics
    # ------------------------------------------------------

    SSR_cf_system = (
        E_C_cf_system
        /
        (E_def_system + EPS)
    ) * 100.0

    SDM_cf_system = (
        E_I_cf_system
        /
        (E_def_system + EPS)
    ) * 100.0

    CLRR_cf_system = (
        E_R_cf_system
        /
        (E_def_system + EPS)
    ) * 100.0

    SSC_cf_system = (
        E_share_cf_system
        /
        (E_S_cf_system + EPS)
    ) * 100.0

    # ------------------------------------------------------
    # Intervention metrics
    # ------------------------------------------------------

    SSR_int_system = (
        E_C_int_system
        /
        (E_def_system + EPS)
    ) * 100.0

    SDM_int_system = (
        E_I_int_system
        /
        (E_def_system + EPS)
    ) * 100.0

    CLRR_int_system = (
        E_R_int_system
        /
        (E_def_system + EPS)
    ) * 100.0

    SSC_int_system = (
        E_share_int_system
        /
        (E_S_int_system + EPS)
    ) * 100.0

    # ------------------------------------------------------
    # SDM reduction
    # ------------------------------------------------------

    SDM_reduction_system = (
        SDM_cf_system
        -
        SDM_int_system
    )

    # ------------------------------------------------------
    # Store system result
    # ------------------------------------------------------

    vii_c_system_rows.append({

        "Use Case":
            uc,

        "Sharing Scope":
            scenario["label"],

        "Load Increase (%)":
            100.0
            * scenario["load_increase"],

