# ==========================================================
# 27. VII-C MATCHED COUNTERFACTUAL / INTERVENTION ANALYSIS
# ==========================================================
#
# This is the principal new analysis for:
#
# VII-C. Scenario-Wise Resilience and Counterfactual Performance
#
# The analysis is performed separately for:
#
#   UC1 Intra-Community Sharing
#   UC2 Inter-Community Sharing
#   UC3 Regional Sharing
#
# For each use case:
#
#   Counterfactual:
#       coordination_factor = 0.00
#
#   Intervention:
#       coordination_factor = 0.72
#
# The same load, PV, support, and evaluation horizon are used.
#
# ATE is based on the reduction in unserved deficit energy:
#
#       ATE =
#       (E_I^CF - E_I^INT)
#       ------------------ x 100
#            E_I^CF
#
# Positive ATE means that the intervention reduces unserved
# deficit energy relative to the matched counterfactual.
#
# ==========================================================

counterfactual_results = {}
counterfactual_trajectories = {}

vii_c_regional_rows = []


for uc, scenario in SCENARIOS.items():

    counterfactual_results[uc] = {}
    counterfactual_trajectories[uc] = {}

    load_factor = (
        1.0
        +
        scenario["load_increase"]
    )

    pv_factor = (
        scenario["pv_availability"]
    )

    support_kw = (
        scenario["support_kw"]
    )

    for region in REGION_NAMES:

        # --------------------------------------------------
        # Construct the matched operating condition
        # --------------------------------------------------

        L_eff_kw = (
            region_load_kw[region]
            * load_factor
        )

        G_eff_kw = (
            region_solar_kw[region]
            * pv_factor
        )

        # --------------------------------------------------
        # Pre-mitigation deficit
        # --------------------------------------------------

        D_kw = np.maximum(
            L_eff_kw
            -
            G_eff_kw,
            0.0
        )

        # ==================================================
        # COUNTERFACTUAL
        # ==================================================
        #
        # No coordinated sharing intervention.
        # ==================================================

        cf = run_closed_loop(
            deficit_kw=D_kw,
            support_kw=support_kw,
            coordination_factor=0.00
        )

        # ==================================================
        # INTERVENTION
        # ==================================================
        #
        # Proposed coordinated sharing.
        # ==================================================

        intervention = run_closed_loop(
            deficit_kw=D_kw,
            support_kw=support_kw,
            coordination_factor=0.72
        )

        # --------------------------------------------------
        # Counterfactual and intervention unserved energy
        # --------------------------------------------------

        E_def = positive_energy(
            D_kw
        )

        E_I_cf = (
            cf["E_I"]
        )

        E_I_int = (
            intervention["E_I"]
        )

        # --------------------------------------------------
        # Avoided unserved energy
        # --------------------------------------------------

        avoided_unserved = (
            E_I_cf
            -
            E_I_int
        )

        # --------------------------------------------------
        # ATE
        # --------------------------------------------------

        ATE = (
            avoided_unserved
            /
            (E_I_cf + EPS)
        ) * 100.0

        # --------------------------------------------------
        # Counterfactual recovery/coordination values
        # --------------------------------------------------

        cf_ssr = cf["SSR"]
        int_ssr = intervention["SSR"]

        cf_sdm = cf["SDM"]
        int_sdm = intervention["SDM"]

        cf_clrr = cf["CLRR"]
        int_clrr = intervention["CLRR"]

        cf_ssc = cf["SSC"]
        int_ssc = intervention["SSC"]

        # --------------------------------------------------
        # Direct reduction in SDM
        # --------------------------------------------------

        SDM_reduction = (
            cf_sdm
            -
            int_sdm
        )

        # --------------------------------------------------
        # Store regional VII-C result
        # --------------------------------------------------

        vii_c_regional_rows.append({

            "Use Case":
                uc,

            "Sharing Scope":
                scenario["label"],

            "Region":
                region,

            "Load Increase (%)":
                100.0
                * scenario["load_increase"],

            "PV Availability (%)":
                100.0
                * scenario["pv_availability"],

            "Available Support (kW)":
                support_kw,

            "E_def (kWh)":
                E_def,

            "E_I Counterfactual (kWh)":
                E_I_cf,

            "E_I Intervention (kWh)":
                E_I_int,

            "Avoided Unserved Energy (kWh)":
                avoided_unserved,

            "ATE (%)":
                ATE,

            "SDM Counterfactual (%)":
                cf_sdm,

            "SDM Intervention (%)":
                int_sdm,

            "SDM Reduction (percentage points)":
                SDM_reduction,

            "SSR Counterfactual (%)":
                cf_ssr,

            "SSR Intervention (%)":
                int_ssr,

            "CLRR Counterfactual (%)":
                cf_clrr,

            "CLRR Intervention (%)":
                int_clrr,

            "SSC Counterfactual (%)":
                cf_ssc,

            "SSC Intervention (%)":
                int_ssc,

            "Counterfactual Conservation Error (kWh)":
                cf["conservation_error"],

            "Intervention Conservation Error (kWh)":
                intervention["conservation_error"]
        })

        # --------------------------------------------------
        # Store detailed result objects
        # --------------------------------------------------

        counterfactual_results[
            uc
        ][
            region
        ] = {

            "E_def_kWh":
                E_def,

            "E_I_counterfactual_kWh":
                E_I_cf,

            "E_I_intervention_kWh":
                E_I_int,

            "avoided_unserved_energy_kWh":
                avoided_unserved,

            "ATE_percent":
                ATE,

            "SDM_reduction_percentage_points":
                SDM_reduction,

            "counterfactual":
                cf,

            "intervention":
                intervention
        }

        counterfactual_trajectories[
            uc
        ][
            region
        ] = {

            "Counterfactual":
                cf,

            "Intervention":
                intervention
        }


