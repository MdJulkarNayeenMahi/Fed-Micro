)

df = df.dropna(
    subset=[date_col]
).copy()


print("\nConsumption categories:")
print(
    df[category_col]
    .dropna()
    .unique()
)


# ==========================================================
# 9. IDENTIFY THE 48 HALF-HOURLY COLUMNS
# ==========================================================

def time_to_minutes(col):
    hour, minute = str(col).split(":")
    return (
        int(hour) * 60
        + int(minute)
    )


time_cols = []

for col in df.columns:

    col_str = str(col).strip()

    if ":" not in col_str:
        continue

    parts = col_str.split(":")

    if len(parts) != 2:
        continue

    try:
        hour = int(parts[0])
        minute = int(parts[1])
    except ValueError:
        continue

    if (
        0 <= hour <= 23
        and minute in (0, 30)
    ):
        time_cols.append(col)


# Remove duplicates while preserving the first occurrence.
time_cols = list(dict.fromkeys(time_cols))


if len(time_cols) != 48:
    raise ValueError(
        f"Expected 48 half-hour columns, "
        f"but detected {len(time_cols)}."
    )


time_cols = sorted(
    time_cols,
    key=time_to_minutes
)


print("\nChronological time columns:")
print(time_cols)


# ==========================================================
# 10. CONVERT TIME-SERIES VALUES TO NUMERIC
# ==========================================================

df[time_cols] = (
    df[time_cols]
    .apply(
        pd.to_numeric,
        errors="coerce"
    )
    .fillna(0.0)
)


# ==========================================================
# 11. EXTRACT LOAD AND PV RECORDS
# ==========================================================

load_df = df[
    df[category_col] == "GC"
].copy()

solar_df = df[
    df[category_col] == "GG"
].copy()


if load_df.empty:
    raise ValueError(
        "No GC load records found."
    )

if solar_df.empty:
    raise ValueError(
        "No GG solar records found."
    )


print(
    "\nNumber of GC records:",
    len(load_df)
)

print(
    "Number of GG records:",
    len(solar_df)
)


# ==========================================================
# 12. DAILY AGGREGATION
# ==========================================================
#
# For each date:
#   1. Sum all households.
#   2. Obtain a 48-step daily profile.
#   3. Average across common dates.
#
# This avoids collapsing the complete historical dataset
# directly into one unrepresentative 48-step profile.
# ==========================================================

daily_load = (
    load_df
    .groupby(date_col)[time_cols]
    .sum()
)

daily_solar = (
    solar_df
    .groupby(date_col)[time_cols]
    .sum()
)


# ==========================================================
# 13. USE COMMON LOAD/PV DATES
# ==========================================================

common_dates = (
    daily_load.index
    .intersection(
        daily_solar.index
    )
)

daily_load = (
    daily_load
    .loc[common_dates]
)

daily_solar = (
    daily_solar
    .loc[common_dates]
)


if len(common_dates) == 0:
    raise ValueError(
        "No common dates exist between load and solar datasets."
    )


print(
    "\nNumber of common daily observations:",
    len(common_dates)
)


# ==========================================================
# 14. CREATE REPRESENTATIVE 48-STEP DAILY PROFILE
# ==========================================================

representative_load_kwh = (
    daily_load
    .mean(axis=0)
    .to_numpy(dtype=float)
)

representative_solar_kwh = (
    daily_solar
    .mean(axis=0)
    .to_numpy(dtype=float)
)


# Numerical cleaning.
representative_load_kwh = np.nan_to_num(
    representative_load_kwh,
    nan=0.0,
    posinf=0.0,
    neginf=0.0
)

representative_solar_kwh = np.nan_to_num(
    representative_solar_kwh,
    nan=0.0,
    posinf=0.0,
    neginf=0.0
)

representative_load_kwh = np.maximum(
    representative_load_kwh,
    0.0
)

representative_solar_kwh = np.maximum(
    representative_solar_kwh,
    0.0
)


print(
    "\nRepresentative load profile (kWh / 30 min):"
)

print(
    np.round(
        representative_load_kwh,
        3
    )
)


print(
    "\nRepresentative solar profile (kWh / 30 min):"
)

print(
    np.round(
        representative_solar_kwh,
        3
    )
)


print(
    "\nRepresentative daily load energy:",
    f"{representative_load_kwh.sum():.3f}",
    "kWh"
)

print(
    "Representative daily solar energy:",
    f"{representative_solar_kwh.sum():.3f}",
    "kWh"
)


# ==========================================================
# 15. CONVERT ENERGY TO AVERAGE POWER
# ==========================================================

representative_load_kw = (
    representative_load_kwh
    / DT_H
)

representative_solar_kw = (
    representative_solar_kwh
    / DT_H
)


# ==========================================================
# 16. REGIONAL AGGREGATION
# ==========================================================

region_load_kw = {}
region_solar_kw = {}


for region in REGION_NAMES:

    household_share = (
        HOUSES_PER_REGION[region]
        / TOTAL_HOUSES
    )

    region_load_kw[region] = (
        representative_load_kw
        * household_share
    )

    region_solar_kw[region] = (
        representative_solar_kw
        * household_share
    )


# ==========================================================
# 17. ENERGY CONVERSION FUNCTION
# ==========================================================

def positive_energy(power_kw):
    """
    Convert a nonnegative power trajectory [kW]
    to energy [kWh].
    """
    return (
        np.sum(
            np.maximum(
                np.asarray(power_kw, dtype=float),
                0.0
            )
        )
        * DT_H
    )


# ==========================================================
# 18. CLOSED-LOOP SIERMVD / EMS
# ==========================================================

def run_closed_loop(
    deficit_kw,
    support_kw,
    coordination_factor,
    gamma=GAMMA,
    eta1=ETA1,
    eta2=ETA2,
    eta3=ETA3
):
    """
    Closed-loop SIERMVD / EMS simulation.

    D(t_k):
        Pre-mitigation deficit power [kW]

    S(t_k):
        Available operational support power [kW]

    M_cmd(t_k):
        EMS mitigation command [kW]

    M(t_k):
        Actual EMS mitigation [kW]

    C(t_k):
        Compensated deficit [kW]

    I(t_k):
        Remaining unserved deficit [kW]

    E_state(t_k):
        Cumulative unserved deficit energy [kWh]

    R_state(t_k):
        Cumulative recovered energy [kWh]

    V_state(t_k):
        Filtered stabilization/recovery state [kWh]

    Accounting:
        D(t_k) = C(t_k) + I(t_k)

    Command:
        M_cmd(k+1)
        = (1-eta2) M_cmd(k)
          + eta1 D(k)

    Method-specific usable support:
        effective_support
        = S(k) * coordination_factor

    Operational restriction:
        0 <= M(k) <= S(k)
        and M(k) <= D(k)
    """

    deficit_kw = np.asarray(
        deficit_kw,
        dtype=float
    )

    n = len(deficit_kw)

    if n == 0:
        raise ValueError(
            "Deficit trajectory is empty."
        )

    if coordination_factor < 0.0:
        raise ValueError(
            "coordination_factor cannot be negative."
        )

    if gamma < 0.0 or gamma > 1.0:
        raise ValueError(
            "gamma must satisfy 0 <= gamma <= 1."
        )

    if not (0.0 <= eta1):
        raise ValueError(
            "eta1 must be nonnegative."
        )

    if not (0.0 <= eta2 <= 1.0):
        raise ValueError(
            "eta2 must satisfy 0 <= eta2 <= 1."
        )

    if not (0.0 <= eta3 <= 1.0):
        raise ValueError(
            "eta3 must satisfy 0 <= eta3 <= 1."
        )

    # ------------------------------------------------------
    # Instantaneous trajectories
    # ------------------------------------------------------

    S = np.zeros(n)
    M_cmd = np.zeros(n)
    M = np.zeros(n)
    C = np.zeros(n)
    I = np.zeros(n)

    # ------------------------------------------------------
    # Cumulative states
    # ------------------------------------------------------

    E_state = np.zeros(n)
    R_state = np.zeros(n)
    V_state = np.zeros(n)

    # ------------------------------------------------------
    # Available support is constant within a use case.
    # ------------------------------------------------------

    S[:] = max(
        float(support_kw),
        0.0
    )

    # ======================================================
    # INITIAL TIME STEP
    # ======================================================

    M_cmd[0] = 0.0
    M[0] = 0.0

    C[0] = min(
        M[0],
        max(deficit_kw[0], 0.0)
    )

    I[0] = max(
        deficit_kw[0] - M[0],
        0.0
    )

    E_state[0] = (
        I[0] * DT_H
    )

    R_state[0] = (
        gamma
        * C[0]
        * DT_H
    )

    V_state[0] = (
        gamma
        * C[0]
        * DT_H
    )

    # ======================================================
    # REMAINING TIME STEPS
    # ======================================================

    for k in range(n - 1):

        # --------------------------------------------------
        # 1. Mitigation command
        # --------------------------------------------------

        M_cmd[k + 1] = (
            (1.0 - eta2)
            * M_cmd[k]
            +
            eta1
            * max(
                deficit_kw[k],
                0.0
            )
        )

        # --------------------------------------------------
        # 2. Method-specific usable support
        # --------------------------------------------------

        effective_support = (
            S[k + 1]
            * coordination_factor
        )

        # --------------------------------------------------
        # 3. Actual EMS mitigation
        #
        # M <= command
        # M <= usable support
        # M <= current deficit
        # --------------------------------------------------

        M[k + 1] = min(
            max(
                M_cmd[k + 1],
                0.0
            ),

            max(
                effective_support,
                0.0
            ),

            max(
                deficit_kw[k + 1],
                0.0
            )
        )

        # --------------------------------------------------
        # 4. Compensated deficit
        # --------------------------------------------------

        C[k + 1] = min(
            M[k + 1],
            max(
                deficit_kw[k + 1],
                0.0
            )
        )

        # --------------------------------------------------
        # 5. Remaining unserved deficit
        # --------------------------------------------------

        I[k + 1] = max(
            deficit_kw[k + 1]
            - M[k + 1],
            0.0
        )

        # --------------------------------------------------
        # 6. Cumulative unserved deficit energy
        # --------------------------------------------------

        E_state[k + 1] = (
            E_state[k]
            +
            I[k + 1] * DT_H
        )

        # --------------------------------------------------
        # 7. Cumulative recovered energy
        # --------------------------------------------------

        R_state[k + 1] = (
            R_state[k]
            +
            gamma
            * C[k + 1]
            * DT_H
        )

        # --------------------------------------------------
        # 8. Stabilization/recovery state
        # --------------------------------------------------

        V_state[k + 1] = (
            (1.0 - eta3)
            * V_state[k]
            +
            gamma
            * C[k + 1]
            * DT_H
        )

    # ======================================================
    # TOTAL ENERGY QUANTITIES
    # ======================================================

    E_def = positive_energy(
        deficit_kw
    )

    E_C = positive_energy(
        C
    )

    E_I = positive_energy(
        I
    )

    E_S = positive_energy(
        S
    )

    E_share = positive_energy(
        M
    )

    # ======================================================
    # DEFICIT ACCOUNTING CHECK
    # ======================================================

    conservation_error = (
        E_def
        -
        E_C
        -
        E_I
    )

    # ======================================================
    # RESILIENCE / COORDINATION METRICS
    # ======================================================

    SSR = (
        E_C
        /
        (E_def + EPS)
    ) * 100.0

    SDM = (
        E_I
        /
        (E_def + EPS)
    ) * 100.0

    E_R = (
        gamma
        * E_C
    )

    CLRR = (
        E_R
        /
        (E_def + EPS)
    ) * 100.0

    SSC = (
        E_share
        /
        (E_S + EPS)
    ) * 100.0

    return {

        # instantaneous quantities
        "D": deficit_kw,
        "S": S,
        "M_cmd": M_cmd,
        "M": M,
        "C": C,
        "I": I,

        # cumulative states
        "E_state": E_state,
        "R_state": R_state,
        "V_state": V_state,

        # total energies
        "E_def": E_def,
        "E_C": E_C,
        "E_I": E_I,
        "E_R": E_R,
        "E_S": E_S,
        "E_share": E_share,

        # metrics
        "SSR": SSR,
        "SDM": SDM,
        "CLRR": CLRR,
        "SSC": SSC,

        # validation
        "conservation_error":
            conservation_error
    }


# ==========================================================
# 19. RUN ORIGINAL UC1-UC3 MODEL COMPARISON
# ==========================================================

results = {}
trajectories = {}


for uc, scenario in SCENARIOS.items():

    results[uc] = {}
    trajectories[uc] = {}

    load_factor = (
        1.0
        +
        scenario["load_increase"]
    )

    pv_factor = (
        scenario["pv_availability"]
    )

    support_kw = (
        scenario["support_kw"]
    )

    for region in REGION_NAMES:

        # --------------------------------------------------
        # Effective load
        # --------------------------------------------------

        L_eff_kw = (
            region_load_kw[region]
            * load_factor
        )

        # --------------------------------------------------
        # Effective PV
        # --------------------------------------------------

        G_eff_kw = (
            region_solar_kw[region]
            * pv_factor
        )

        # --------------------------------------------------
        # Pre-mitigation deficit
        #
        # D = max(L_eff - G_eff, 0)
        #
        # Operational support is NOT subtracted here.
        # --------------------------------------------------

        D_kw = np.maximum(
            L_eff_kw
            -
            G_eff_kw,
            0.0
        )

        results[uc][region] = {}
        trajectories[uc][region] = {}

        # --------------------------------------------------
        # Run all coordination architectures
        # --------------------------------------------------

        for (
            model,
            coordination_factor
        ) in MODEL_COORDINATION_FACTOR.items():

            sim = run_closed_loop(
                deficit_kw=D_kw,
                support_kw=support_kw,
                coordination_factor=coordination_factor
            )

            results[
                uc
            ][
                region
            ][
                model
            ] = {

                "E_def_kWh":
                    sim["E_def"],

                "E_C_kWh":
                    sim["E_C"],

                "E_I_kWh":
                    sim["E_I"],

                "E_R_kWh":
                    sim["E_R"],

                "E_S_kWh":
                    sim["E_S"],

                "E_share_kWh":
                    sim["E_share"],

                "SSR_percent":
                    sim["SSR"],

                "SDM_percent":
                    sim["SDM"],

                "CLRR_percent":
                    sim["CLRR"],

                "SSC_percent":
                    sim["SSC"],

                "conservation_error_kWh":
                    sim[
                        "conservation_error"
                    ]
            }

            trajectories[
                uc
            ][
                region
            ][
                model
            ] = sim


# ==========================================================
# 20. SYSTEM-LEVEL MODEL COMPARISON
# ==========================================================

system_results = []


for uc, scenario in SCENARIOS.items():

    for model in MODEL_COORDINATION_FACTOR:

        E_def = 0.0
        E_C = 0.0
        E_I = 0.0
        E_R = 0.0
        E_S = 0.0
        E_share = 0.0

        for region in REGION_NAMES:

            row = (
                results
                [uc]
                [region]
                [model]
            )

            E_def += (
                row["E_def_kWh"]
            )

            E_C += (
                row["E_C_kWh"]
            )

            E_I += (
                row["E_I_kWh"]
            )

            E_R += (
                row["E_R_kWh"]
            )

            E_S += (
                row["E_S_kWh"]
            )

            E_share += (
                row["E_share_kWh"]
            )

        SSR = (
            E_C
            /
            (E_def + EPS)
        ) * 100.0

        SDM = (
            E_I
            /
            (E_def + EPS)
        ) * 100.0

        CLRR = (
            E_R
            /
            (E_def + EPS)
        ) * 100.0

        SSC = (
            E_share
            /
            (E_S + EPS)
        ) * 100.0

        system_results.append({

            "Use Case":
                uc,

            "Sharing Scope":
                scenario["label"],

            "Method":
                model,

            "E_def (kWh)":
                E_def,

            "E_C (kWh)":
                E_C,

            "E_I (kWh)":
                E_I,

            "E_R (kWh)":
                E_R,

            "E_S (kWh)":
                E_S,

            "E_share (kWh)":
                E_share,

            "SSR (%)":
                SSR,

            "SDM (%)":
                SDM,

            "CLRR (%)":
                CLRR,

            "SSC (%)":
                SSC
        })


system_results_df = pd.DataFrame(
    system_results
)


# ==========================================================
# 21. PROPOSED MODEL REGIONAL RESULTS
# ==========================================================

regional_rows = []


for uc, scenario in SCENARIOS.items():

    for region in REGION_NAMES:

        row = (
            results
            [uc]
            [region]
            [OURS]
        )

        regional_rows.append({

            "Use Case":
                uc,

            "Sharing Scope":
                scenario["label"],

            "Region":
                region,

            "E_def (kWh)":
                row["E_def_kWh"],

            "E_C (kWh)":
                row["E_C_kWh"],

