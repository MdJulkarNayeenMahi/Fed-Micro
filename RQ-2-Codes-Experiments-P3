import numpy as np


# ==========================================================
# HDFL-PINN-SIERMVD
# FULLY FIXED EXPERIMENTAL SIMULATION
# ==========================================================
#
# PURPOSE
# -------
# This script supports the experimental results used in
# Sections VII-A, VII-B, and VII-C.
#
# VII-C is defined by the three coordination/sharing scopes:
#
#   UC1 = Intra-Community Sharing
#   UC2 = Inter-Community Sharing
#   UC3 = Regional Sharing
#
# There is NO Low/Moderate/Severe terminology in the
# principal VII-C analysis.
#
# The three use cases retain their controlled operating
# conditions:
#
#   UC1: +10% load, 90% PV, 1.6 kW available support
#   UC2: +25% load, 70% PV, 2.4 kW available support
#   UC3: +50% load, 50% PV, 3.3 kW available support
#
# For VII-C, each use case is evaluated under a matched pair:
#
#   Counterfactual:
#       coordination_factor = 0.00
#       M(t_k) = 0
#
#   Intervention:
#       coordination_factor = 0.72
#       HDFL-PINN-SIERMVD sharing/coordination
#
# Both cases use the same:
#   - regional load profile
#   - regional PV profile
#   - scenario conditions
#   - support availability
#   - evaluation horizon
#
# The script reports:
#
#   E_def
#   E_I^CF
#   E_I^INT
#   avoided unserved energy
#   ATE
#   SSR
#   SDM
#   CLRR
#   SSC
#
# IMPORTANT INTERPRETATION
# ------------------------
# Under this specific counterfactual design, the control case has
# M=0, so E_I^CF = E_def up to numerical precision.
# Therefore:
#
#   ATE ~= SSR
#
# The script reports an explicit ATE/SSR consistency check rather
# than treating ATE as an independent metric.
#
# The coordination factors are controlled simulation parameters,
# not empirically learned coefficients.
# ==========================================================


# ==========================================================
# 1. CONFIGURATION
# ==========================================================

FILE_PATH = (
    r"C:\Users\n10852468\Downloads"
    r"\2012-2013 Solar home electricity data v2.csv"
)

