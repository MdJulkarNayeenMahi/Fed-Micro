import pandas as pd
import numpy as np

# ==========================================================
# HDFL-PINN-SIERMVD
# REVISED EXPERIMENTAL SIMULATION
# ==========================================================
#
# Revised physical/operational sequence:
#
# Ausgrid load + PV
#        |
#        v
# Representative 48-step daily profile
#        |
#        v
# Regional aggregation
#        |
#        v
# Weather/scenario-adjusted load and PV
#        |
#        v
# Pre-mitigation deficit D
#        |
#        v
# Available support S
#        |
#        v
# EMS mitigation M
#        |
#        +------> Compensated deficit C
#        |
#        +------> Remaining unserved deficit I
#                         |
#                         v
#                    E, R, V
#
# Key accounting:
#
# D(k) = C(k) + I(k)
#
# E_def = E_C + E_I
#
# SSR = E_C / E_def
#
# SDM = E_I / E_def
#
# ==========================================================


# ==========================================================
# 1. CONFIGURATION
# ==========================================================

FILE_PATH = (
    r"C:\Users\n10852468\Downloads"
    r"\2012-2013 Solar home electricity data v2.csv"
)

DT_H = 0.5                    # 30 minutes = 0.5 h
EPS = 1e-6

# ----------------------------------------------------------
# Representative regional configuration
# ----------------------------------------------------------
REGION_NAMES = [
    "Sydney North",
    "Sydney West",
    "Sydney South",
    "Hunter/CC",
    "North Coast"
]

HOUSES_PER_REGION = {
    "Sydney North": 20,
    "Sydney West": 30,
    "Sydney South": 40,
    "Hunter/CC": 35,
    "North Coast": 10
}

TOTAL_HOUSES = sum(
    HOUSES_PER_REGION.values()
)

# ==========================================================
# 2. CONTROLLED USE CASES
# ==========================================================
#
# UC1 = Intra-Community
# UC2 = Inter-Community
# UC3 = Regional
#
# These are controlled simulation assumptions.
# They are not empirical Ausgrid measurements.
# ==========================================================

SCENARIOS = {

    "UC1": {
        "label": "Intra-Community",

        # 10% load increase
        "load_increase": 0.10,

        # 90% of nominal PV available
        "pv_availability": 0.90,

        # available operational support
        "support_kw": 1.6
    },

    "UC2": {
        "label": "Inter-Community",

        # 25% load increase
        "load_increase": 0.25,

        # 70% of nominal PV available
        "pv_availability": 0.70,

        # available operational support
        "support_kw": 2.4
    },

    "UC3": {
        "label": "Regional",

        # 50% load increase
        "load_increase": 0.50,

        # 50% of nominal PV available
        "pv_availability": 0.50,

        # available operational support
        "support_kw": 3.3
    }
}


# ==========================================================
# 3. MODEL CONFIGURATION
# ==========================================================
#
# These are controlled coordination capabilities used to
# represent the different coordination architectures.
#
# IMPORTANT:
# They are simulation parameters, not learned empirical
# coefficients.
# ==========================================================

MODEL_COORDINATION_FACTOR = {

    "Baseline":
        0.00,

    "Centralised FL":
        0.18,

    "Decentralised FL":
        0.25,

    "HDFL-DCM":
        0.35,

    "HDFL-GC":
        0.42,

    "HDFL-MCMC":
        0.55,

    "HDFL-PINN-SIERMVD (Ours)":
        0.72
}


# ==========================================================
# 4. REVISED SIERMVD / EMS PARAMETERS
# ==========================================================

ETA1 = 0.20       # mitigation command gain
ETA2 = 0.40       # command persistence/dissipation
ETA3 = 0.20       # stabilization coefficient
GAMMA = 0.85      # recovery efficiency


# ==========================================================
# 5. LOAD THE AUSGRID DATA
# ==========================================================

df = pd.read_csv(
    FILE_PATH,
    skiprows=1,
    low_memory=False
)

df.columns = (
    df.columns
    .astype(str)
    .str.strip()
)

print("=" * 120)
print("DATASET")
print("=" * 120)

print("\nColumns found:")
print(df.columns.tolist())


# ==========================================================
# 6. IDENTIFY CONSUMPTION CATEGORY
# ==========================================================

category_col = None

for col in df.columns:

    if "CONSUMPTION CATEGORY" in col.upper():

        category_col = col
        break

if category_col is None:

    raise ValueError(
        "Consumption Category column was not found."
    )


df[category_col] = (
    df[category_col]
    .astype(str)
    .str.strip()
    .str.upper()
)

print("\nAvailable consumption categories:")
print(
    df[category_col]
    .dropna()
    .unique()
)


# ==========================================================
# 7. IDENTIFY DATE COLUMN
# ==========================================================

date_col = None

for col in df.columns:

    if str(col).strip().lower() == "date":

        date_col = col
        break

if date_col is None:

    raise ValueError(
        "Date column was not found."
    )


df[date_col] = pd.to_datetime(
    df[date_col],
    errors="coerce"
)

df = df.dropna(
    subset=[date_col]
).copy()


# ==========================================================
# 8. IDENTIFY THE 48 HALF-HOURLY COLUMNS
# ==========================================================

def time_to_minutes(col):

    hour, minute = str(col).split(":")

    return (
        int(hour) * 60
        + int(minute)
    )


time_cols = []

for col in df.columns:

    col_str = str(col).strip()

    if ":" not in col_str:
        continue

    parts = col_str.split(":")

    if len(parts) != 2:
        continue

    try:

        hour = int(parts[0])
        minute = int(parts[1])

    except ValueError:

        continue

    if (
        0 <= hour <= 23
        and minute in (0, 30)
    ):

        time_cols.append(col)


time_cols = list(
    dict.fromkeys(time_cols)
)

if len(time_cols) != 48:

    raise ValueError(
        f"Expected 48 half-hour columns, "
        f"but detected {len(time_cols)}."
    )


time_cols = sorted(
    time_cols,
    key=time_to_minutes
)

print("\nChronological time columns:")
print(time_cols)


# ==========================================================
# 9. CONVERT TIME-SERIES VALUES TO NUMERIC
# ==========================================================

df[time_cols] = (
    df[time_cols]
    .apply(
        pd.to_numeric,
        errors="coerce"
    )
    .fillna(0.0)
)


# ==========================================================
# 10. EXTRACT LOAD AND PV RECORDS
# ==========================================================

load_df = df[
    df[category_col] == "GC"
].copy()

solar_df = df[
    df[category_col] == "GG"
].copy()

if load_df.empty:

    raise ValueError(
        "No GC load records found."
    )

if solar_df.empty:

    raise ValueError(
        "No GG solar records found."
    )

print("\nNumber of GC records:",
      len(load_df))

print("Number of GG records:",
      len(solar_df))


# ==========================================================
# 11. DAILY AGGREGATION
# ==========================================================
#
# IMPORTANT:
#
# The original implementation summed the entire historical
# dataset into a single 48-step vector.
#
# That is not appropriate for a 24-hour simulation.
#
# Here:
#
#   1. Sum households for each date.
#   2. Obtain one 48-step daily profile for each date.
#   3. Average across common dates.
#
# ==========================================================

daily_load = (
    load_df
    .groupby(date_col)[time_cols]
    .sum()
)

daily_solar = (
    solar_df
    .groupby(date_col)[time_cols]
    .sum()
)


# ----------------------------------------------------------
# Use only dates present in both load and PV datasets
# ----------------------------------------------------------

common_dates = (
    daily_load.index
    .intersection(
        daily_solar.index
    )
)

daily_load = (
    daily_load
    .loc[common_dates]
)

daily_solar = (
    daily_solar
    .loc[common_dates]
)

if len(common_dates) == 0:

    raise ValueError(
        "No common dates exist between load and solar data."
    )

print(
    "\nNumber of common daily observations:",
    len(common_dates)
)


# ==========================================================
# 12. CREATE REPRESENTATIVE 48-STEP DAILY PROFILE
# ==========================================================

representative_load_kwh = (
    daily_load
    .mean(axis=0)
    .to_numpy(dtype=float)
)

representative_solar_kwh = (
    daily_solar
    .mean(axis=0)
    .to_numpy(dtype=float)
)


# ----------------------------------------------------------
# Numerical cleaning
# ----------------------------------------------------------

representative_load_kwh = np.nan_to_num(
    representative_load_kwh,
    nan=0.0,
    posinf=0.0,
    neginf=0.0
)

representative_solar_kwh = np.nan_to_num(
    representative_solar_kwh,
    nan=0.0,
    posinf=0.0,
    neginf=0.0
)


representative_load_kwh = np.maximum(
    representative_load_kwh,
    0.0
)

representative_solar_kwh = np.maximum(
    representative_solar_kwh,
    0.0
)


# ==========================================================
# 13. CONVERT ENERGY TO AVERAGE POWER
# ==========================================================

representative_load_kw = (
    representative_load_kwh
    / DT_H
)

representative_solar_kw = (
    representative_solar_kwh
    / DT_H
)


print("\nRepresentative load profile (kWh / 30 min):")

print(
    np.round(
        representative_load_kwh,
        3
    )
)


print("\nRepresentative solar profile (kWh / 30 min):")

print(
    np.round(
        representative_solar_kwh,
        3
    )
)


print(
    "\nRepresentative daily load energy:",
    f"{representative_load_kwh.sum():.3f}",
    "kWh"
)

print(
    "Representative daily solar energy:",
    f"{representative_solar_kwh.sum():.3f}",
    "kWh"
)


# ==========================================================
# 14. REGIONAL AGGREGATION
# ==========================================================
#
# Regional scaling is based on household share:
#
#   share_r = N_r / sum_j N_j
#
# This avoids mixing household counts with energy values.
# ==========================================================

region_load_kw = {}
region_solar_kw = {}

for region in REGION_NAMES:

    household_share = (
        HOUSES_PER_REGION[region]
        / TOTAL_HOUSES
    )

    region_load_kw[region] = (
        representative_load_kw
        * household_share
    )

    region_solar_kw[region] = (
        representative_solar_kw
        * household_share
    )


# ==========================================================
# 15. ENERGY CONVERSION FUNCTION
# ==========================================================

def positive_energy(power_kw):

    """
    Convert a nonnegative power trajectory (kW)
    into cumulative energy (kWh).
    """

    return (
        np.sum(
            np.maximum(
                power_kw,
                0.0
            )
        )
        * DT_H
    )


# ==========================================================
# 16. REVISED CLOSED-LOOP SIERMVD / EMS
# ==========================================================

def run_closed_loop(
    deficit_kw,
    support_kw,
    coordination_factor,
    gamma=GAMMA,
    eta1=ETA1,
    eta2=ETA2,
    eta3=ETA3
):

    """
    Revised closed-loop SIERMVD implementation.

    Variables:

        D(t_k)
            Pre-mitigation deficit power [kW]

        S(t_k)
            Available operational support power [kW]

        M_cmd(t_k)
            EMS mitigation command [kW]

        M(t_k)
            Actual EMS mitigation power [kW]

        C(t_k)
            Compensated deficit power [kW]

        I(t_k)
            Remaining unserved deficit power [kW]

        E(t_k)
            Cumulative unserved deficit energy [kWh]

        R(t_k)
            Cumulative recovered energy [kWh]

        V(t_k)
            Filtered stabilization/recovery state [kWh]

    Deficit accounting:

        D(t_k) = C(t_k) + I(t_k)

    Command equation:

        M_cmd(k+1)
            = (1-eta2) M_cmd(k)
              + eta1 D(k)

    Operational constraint:

        0 <= M(k) <= S(k)
    """

    n = len(deficit_kw)

    # ------------------------------------------------------
    # Allocate instantaneous trajectories
    # ------------------------------------------------------

    S = np.zeros(n)

    M_cmd = np.zeros(n)
    M = np.zeros(n)

    C = np.zeros(n)
    I = np.zeros(n)

    # ------------------------------------------------------
    # Allocate cumulative states
    # ------------------------------------------------------

    E_state = np.zeros(n)
    R_state = np.zeros(n)
    V_state = np.zeros(n)

    # ------------------------------------------------------
    # Available support
    # ------------------------------------------------------

    S[:] = max(
        float(support_kw),
        0.0
    )


    # ======================================================
    # TIME-STEP 0
    # ======================================================

    M_cmd[0] = 0.0

    M[0] = 0.0

    C[0] = min(
        M[0],
        max(deficit_kw[0], 0.0)
    )

    I[0] = max(
        deficit_kw[0] - M[0],
        0.0
    )

    # Cumulative states at initialization
    E_state[0] = (
        I[0] * DT_H
    )

    R_state[0] = (
        gamma
        * C[0]
        * DT_H
    )

    V_state[0] = (
        gamma
        * C[0]
        * DT_H
    )


    # ======================================================
    # REMAINING TIME STEPS
    # ======================================================

    for k in range(n - 1):

        # --------------------------------------------------
        # 1. Mitigation command
        #
        # M_cmd(k+1)
        # =
        # (1-eta2)M_cmd(k)
        # +
        # eta1 D(k)
        # --------------------------------------------------

        M_cmd[k + 1] = (
            (1.0 - eta2)
            * M_cmd[k]
            +
            eta1
            * max(
                deficit_kw[k],
                0.0
            )
        )


        # --------------------------------------------------
        # 2. Method-specific usable support
        # --------------------------------------------------

        effective_support = (
            S[k + 1]
            * coordination_factor
        )


        # --------------------------------------------------
        # 3. Actual EMS mitigation
        #
        # 0 <= M <= S
        #
        # and M cannot exceed D.
        # --------------------------------------------------

        M[k + 1] = min(
            max(
                M_cmd[k + 1],
                0.0
            ),

            max(
                effective_support,
                0.0
            ),

            max(
                deficit_kw[k + 1],
                0.0
            )
        )


        # --------------------------------------------------
        # 4. Compensated deficit
        # --------------------------------------------------

        C[k + 1] = min(
            M[k + 1],
            max(
                deficit_kw[k + 1],
                0.0
            )
        )


        # --------------------------------------------------
        # 5. Remaining unserved deficit
        # --------------------------------------------------

        I[k + 1] = max(
            deficit_kw[k + 1]
            - M[k + 1],
            0.0
        )


        # --------------------------------------------------
        # 6. Cumulative unserved deficit energy
        # --------------------------------------------------

        E_state[k + 1] = (
            E_state[k]
            +
            I[k + 1] * DT_H
        )


        # --------------------------------------------------
        # 7. Cumulative recovered energy
        # --------------------------------------------------

        R_state[k + 1] = (
            R_state[k]
            +
            gamma
            * C[k + 1]
            * DT_H
        )


        # --------------------------------------------------
        # 8. Stabilization state
        # --------------------------------------------------

        V_state[k + 1] = (
            (1.0 - eta3)
            * V_state[k]
            +
            gamma
            * C[k + 1]
            * DT_H
        )


    # ======================================================
    # TOTAL ENERGY QUANTITIES
    # ======================================================

    E_def = positive_energy(
        deficit_kw
    )

    E_C = positive_energy(
        C
    )

    E_I = positive_energy(
        I
    )

    E_S = positive_energy(
        S
    )

    E_share = positive_energy(
        M
    )


    # ======================================================
    # ENERGY ACCOUNTING CHECK
    #
    # E_def = E_C + E_I
    # ======================================================

    conservation_error = (
        E_def
        -
        E_C
        -
        E_I
    )


    # ======================================================
    # SSR
    # ======================================================

    SSR = (
        E_C
        /
        (E_def + EPS)
    ) * 100.0


    # ======================================================
    # SDM
    # ======================================================

    SDM = (
        E_I
        /
        (E_def + EPS)
    ) * 100.0


    # ======================================================
    # CLRR
    #
    # Recovered energy:
    #
    # E_R = gamma E_C
    # ======================================================

    E_R = (
        gamma * E_C
    )

    CLRR = (
        E_R
        /
        (E_def + EPS)
    ) * 100.0


    # ======================================================
    # SSC
    #
    # Support utilisation:
    #
    # E_share / E_S
    # ======================================================

    SSC = (
        E_share
        /
        (E_S + EPS)
    ) * 100.0


    return {

        # --------------------------------------------------
        # instantaneous quantities
        # --------------------------------------------------

        "D": deficit_kw,

        "S": S,

        "M_cmd": M_cmd,

        "M": M,

        "C": C,

        "I": I,


        # --------------------------------------------------
        # cumulative states
        # --------------------------------------------------

        "E_state": E_state,

        "R_state": R_state,

        "V_state": V_state,


        # --------------------------------------------------
        # energy totals
        # --------------------------------------------------

        "E_def": E_def,

        "E_C": E_C,

        "E_I": E_I,

        "E_R": E_R,

        "E_S": E_S,

        "E_share": E_share,


        # --------------------------------------------------
        # metrics
        # --------------------------------------------------

        "SSR": SSR,

        "SDM": SDM,

        "CLRR": CLRR,

        "SSC": SSC,


        # --------------------------------------------------
        # validation
        # --------------------------------------------------

        "conservation_error":
            conservation_error
    }


# ==========================================================
# 17. RUN THE COMPLETE EXPERIMENT
# ==========================================================

results = {}

trajectories = {}


for uc, scenario in SCENARIOS.items():

    results[uc] = {}

    trajectories[uc] = {}


    # ------------------------------------------------------
    # Scenario parameters
    # ------------------------------------------------------

    load_factor = (
        1.0
        +
        scenario["load_increase"]
    )

    pv_factor = (
        scenario["pv_availability"]
    )

    support_kw = (
        scenario["support_kw"]
    )


    for region in REGION_NAMES:

        # --------------------------------------------------
        # Effective load
        # --------------------------------------------------

        L_eff_kw = (
            region_load_kw[region]
            * load_factor
        )


        # --------------------------------------------------
        # Effective renewable generation
        # --------------------------------------------------

        G_eff_kw = (
            region_solar_kw[region]
            * pv_factor
        )


        # --------------------------------------------------
        # PRE-MITIGATION DEFICIT
        #
        # D_r(t_k)
        # =
        # max(L_eff - G_eff, 0)
        #
        # Operational support is NOT subtracted here.
        # --------------------------------------------------

        D_kw = np.maximum(
            L_eff_kw
            -
            G_eff_kw,
            0.0
        )


        results[uc][region] = {}

        trajectories[uc][region] = {}


        # --------------------------------------------------
        # Evaluate every model
        # --------------------------------------------------

        for (
            model,
            coordination_factor
        ) in MODEL_COORDINATION_FACTOR.items():

            sim = run_closed_loop(

                deficit_kw=D_kw,

                support_kw=support_kw,

                coordination_factor=
                    coordination_factor
            )


            # ------------------------------------------------
            # Aggregate results
            # ------------------------------------------------

            results[uc][region][model] = {

                "E_def_kWh":
                    sim["E_def"],

                "E_C_kWh":
                    sim["E_C"],

                "E_I_kWh":
                    sim["E_I"],

                "E_R_kWh":
                    sim["E_R"],

                "E_S_kWh":
                    sim["E_S"],

                "E_share_kWh":
                    sim["E_share"],

                "SSR_percent":
                    sim["SSR"],

                "SDM_percent":
                    sim["SDM"],

                "CLRR_percent":
                    sim["CLRR"],

                "SSC_percent":
                    sim["SSC"],

                "conservation_error_kWh":
                    sim[
                        "conservation_error"
                    ]
            }


            # ------------------------------------------------
            # Full trajectories
            # ------------------------------------------------

            trajectories[
                uc
            ][
                region
            ][
                model
            ] = sim


# ==========================================================
# 18. SYSTEM-LEVEL AGGREGATION
# ==========================================================

system_results = []


for uc, scenario in SCENARIOS.items():

    for model in MODEL_COORDINATION_FACTOR:

        E_def = 0.0
        E_C = 0.0
        E_I = 0.0
        E_R = 0.0
        E_S = 0.0
        E_share = 0.0


        for region in REGION_NAMES:

            row = (
                results
                [uc]
                [region]
                [model]
            )


            E_def += (
                row["E_def_kWh"]
            )

            E_C += (
                row["E_C_kWh"]
            )

            E_I += (
                row["E_I_kWh"]
            )

            E_R += (
                row["E_R_kWh"]
            )

            E_S += (
                row["E_S_kWh"]
            )

            E_share += (
                row["E_share_kWh"]
            )


        # --------------------------------------------------
        # System SSR
        # --------------------------------------------------

        SSR = (
            E_C
            /
            (E_def + EPS)
        ) * 100.0


        # --------------------------------------------------
        # System SDM
        # --------------------------------------------------

        SDM = (
            E_I
            /
            (E_def + EPS)
        ) * 100.0


        # --------------------------------------------------
        # System CLRR
        # --------------------------------------------------

        CLRR = (
            E_R
            /
            (E_def + EPS)
        ) * 100.0


        # --------------------------------------------------
        # System SSC
        # --------------------------------------------------

        SSC = (
            E_share
            /
            (E_S + EPS)
        ) * 100.0


        system_results.append({

            "Use Case":
                uc,

            "Coordination Level":
                scenario["label"],

            "Method":
                model,

            "E_def (kWh)":
                E_def,

            "E_C (kWh)":
                E_C,

            "E_I (kWh)":
                E_I,

            "E_R (kWh)":
                E_R,

            "E_S (kWh)":
                E_S,

            "E_share (kWh)":
                E_share,

            "SSR (%)":
                SSR,

            "SDM (%)":
                SDM,

            "CLRR (%)":
                CLRR,

            "SSC (%)":
                SSC
        })


system_results_df = pd.DataFrame(
    system_results
)


# ==========================================================
# 19. PROPOSED MODEL REGIONAL RESULTS
# ==========================================================

OURS = (
    "HDFL-PINN-SIERMVD (Ours)"
)

regional_rows = []


for uc, scenario in SCENARIOS.items():

    for region in REGION_NAMES:

        row = (
            results
            [uc]
            [region]
            [OURS]
        )


        regional_rows.append({

            "Use Case":
                uc,

            "Coordination Level":
                scenario["label"],

            "Region":
                region,

            "E_def (kWh)":
                row["E_def_kWh"],

            "E_C (kWh)":
                row["E_C_kWh"],

            "E_I (kWh)":
                row["E_I_kWh"],

            "E_R (kWh)":
                row["E_R_kWh"],

            "SSR (%)":
                row["SSR_percent"],

            "SDM (%)":
                row["SDM_percent"],

            "CLRR (%)":
                row["CLRR_percent"],

            "SSC (%)":
                row["SSC_percent"]
        })


regional_results_df = pd.DataFrame(
    regional_rows
)


# ==========================================================
# 20. COMPLETE TIME-SERIES DATASET
#
# This output is specifically required for VII-B.
# ==========================================================

trajectory_rows = []


for uc, scenario in SCENARIOS.items():

    for region in REGION_NAMES:

        for model in MODEL_COORDINATION_FACTOR:

            sim = (
                trajectories
                [uc]
                [region]
                [model]
